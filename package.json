{
  "name": "mobile-operation-reliability",
  "version": "1.0.0",
  "private": true,
  "description": "FlorexTech Mobile Operation Reliability SDK",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "lint": "eslint packages/*/src packages/*/test",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "coverage": "pnpm -r coverage && node scripts/normalize-lcov.mjs",
    "sonar:up": "node scripts/sonar.mjs up",
    "sonar:down": "node scripts/sonar.mjs down",
    "sonar:scan": "pnpm typecheck && pnpm lint && pnpm coverage && node scripts/sonar.mjs scan",
    "sonar:status": "node scripts/sonar.mjs status",
    "security:code": "node scripts/semgrep.mjs",
    "security:deps": "pnpm audit --audit-level low",
    "security:check": "pnpm security:deps && pnpm security:code",
    "quality:gate": "pnpm install --frozen-lockfile && pnpm sonar:up && pnpm security:check && pnpm sonar:scan && git diff --check && git diff --cached --check"
  },
  "license": "ISC",
  "pnpm": { "overrides": { "uuid": "11.1.1" } },
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "c8": "^12.0.0",
    "eslint": "^10.10.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
