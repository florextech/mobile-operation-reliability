{
  "name": "@florexlabs/core",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "coverage": "pnpm build && c8 --all --src dist --include \"dist/**/*.js\" --include \"src/**/*.ts\" --reporter lcov --reporter text --reporter json-summary node --test test/*.test.mjs"
  }
}
