{
  "name": "@florexlabs/mor-expo",
  "version": "0.2.0-alpha.0",
  "description": "Expo SQLite storage adapter for @florexlabs/mor.",
  "type": "module",
  "sideEffects": false,
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "dependencies": {
    "@florexlabs/mor": "workspace:*",
    "@florexlabs/mor-sqlite": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "coverage": "pnpm build && c8 --all --src dist --include \"dist/**/*.js\" --include \"src/**/*.ts\" --reporter lcov --reporter text --reporter json-summary node --test test/*.test.mjs"
  }
}
